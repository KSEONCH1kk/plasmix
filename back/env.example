# Database
DATABASE_URL=postgresql://user:password@localhost:5432/plasmix_db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Plugin API Key
PLUGIN_API_KEY=your-secret-key-here

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Server
HOST=0.0.0.0
PORT=8000

# LiteBans Database (MySQL)
LITEBANS_HOST=localhost
LITEBANS_PORT=3306
LITEBANS_USER=root
LITEBANS_PASSWORD=your_mysql_password
LITEBANS_DATABASE=litebans

# Robokassa Payment Gateway
ROBOKASSA_MERCHANT_LOGIN=your_merchant_login
ROBOKASSA_PASSWORD1=your_password1
ROBOKASSA_PASSWORD2=your_password2
ROBOKASSA_IS_TEST=True
ROBOKASSA_ALGORITHM=md5

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:3000

